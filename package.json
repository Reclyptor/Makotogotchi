{
  "name": "makotogotchi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "atlas": "node scripts/atlas.ts",
    "head-anchors": "node scripts/head-anchors.ts",
    "art:natsumi": "node scripts/art/natsumi.mjs",
    "art:portrait": "node scripts/art/portrait.ts",
    "art:props": "node scripts/art/props.mjs",
    "test:e2e": "npm run build && PLAYWRIGHT_CHROME=\"$(readlink -f /run/current-system/sw/bin/google-chrome 2>/dev/null || true)\" playwright test"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "mongodb": "^7.5.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "fast-check": "^4.9.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  }
}
